# Copy this file to .env and fill in real values. Never commit .env.
#
# Supabase project credentials (Project Settings → API).
# Requires the pgvector extension enabled and sql_queries/*.sql applied — see README.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# OpenRouter API key (https://openrouter.ai/keys). OpenAI-compatible API used for all LLM calls.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openrouter/auto     # optional — auto picks an available model; pin a specific model id instead if needed

# Optional — Uvicorn bind address and debug flag. Defaults shown.
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
